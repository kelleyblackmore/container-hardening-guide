<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
   A HAND-WRITTEN XCCDF 1.2 TAILORING FILE ("answer file"), ANNOTATED
  =============================================================================
   This file is here to be READ, not to be used. The one you actually scan with
   is generated by oscap/generate-tailoring.sh from oscap/not-applicable.rules
   and lands in results/tailored/. Generating it means the justifications live
   in a reviewable text file instead of in XML, and it cannot drift from them.

   But you should know what the generator is producing, because sooner or later
   you will have to read one that somebody else wrote, or hand-edit one to add
   a refine-value. So: every element below is explained.

   Validate any tailoring file before you trust it:
       oscap xccdf validate example-tailoring.xml
   And list the profiles it defines:
       oscap info example-tailoring.xml
  =============================================================================
-->
<xccdf-1.2:Tailoring
    xmlns:xccdf-1.2="http://checklists.nist.gov/xccdf/1.2"
    id="xccdf_mil.disa.stig_tailoring_container_example">
  <!--
    id= on <Tailoring> is a document identifier. It must be a valid XCCDF id
    (NCName, conventionally reverse-DNS style). oscap does not resolve it
    anywhere; it exists so the document can be referenced and versioned.
  -->

  <!--
    <benchmark href=...> points at the SCAP content this tailoring extends.
    The href is informational for oscap - you still pass the datastream on the
    command line - but STIG Viewer and other consumers use it to pair the
    tailoring with the right benchmark. Keep it accurate.
  -->
  <xccdf-1.2:benchmark href="/usr/share/xml/scap/ssg/content/ssg-rhel9-ds.xml"/>

  <!--
    <version time=...> is YOUR version of the tailoring, not the benchmark's.
    Bump it whenever you change a selection. The timestamp is what tells an
    assessor a year from now whether this file predates the finding they are
    looking at.
  -->
  <xccdf-1.2:version time="2026-08-01T00:00:00">1</xccdf-1.2:version>

  <!--
    The Profile element is the whole point of the document.

      id=      the NEW profile id. This is what you pass to
               `oscap xccdf eval --profile <this>`. Passing the BASE profile id
               instead is the classic mistake: the scan runs, but none of your
               tailoring is applied and the results silently look wrong.

      extends= the published profile you are tailoring. Everything in it is
               inherited; the elements below are deltas on top of it.
  -->
  <xccdf-1.2:Profile
      id="xccdf_mil.disa.stig_profile_stig_container_example"
      extends="xccdf_org.ssgproject.content_profile_stig">

    <!--
      override="true" replaces the inherited title rather than appending to it.
      Name the SYSTEM this profile describes. "Tailored" tells the reader
      nothing; "RHEL 9 STIG - container image" tells them the scope.
    -->
    <xccdf-1.2:title override="true">DISA RHEL 9 STIG - Container Image (example)</xccdf-1.2:title>

    <xccdf-1.2:description override="true">
      Example tailoring of the DISA RHEL 9 STIG for an unprivileged OCI container
      image. Rules governing the bootloader, kernel, node storage layout, and
      host services are deselected as Not Applicable: those controls belong to
      the node and the orchestrator, which the container inherits and cannot
      influence from inside its own namespace.
    </xccdf-1.2:description>

    <!-- =====================================================================
         1. UNSELECT - mark a rule Not Applicable
         =====================================================================
         selected="false" makes the result "notselected", which excludes the
         rule from the pass/fail score entirely. It does NOT make it pass.

         Always leave the justification in an XML comment right above it. The
         generated answer file does this automatically from the comment blocks
         in not-applicable.rules.
    -->

    <!-- Not Applicable: /etc/resolv.conf is bind-mounted by the container
         engine or the kubelet at start-up; anything the image ships is
         replaced before PID 1 runs. Enforced at the cluster DNS layer. -->
    <xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_network_configure_name_resolution"
                      selected="false"/>

    <!-- Not Applicable: FIPS:STIG crypto policy requires the kernel to be in
         FIPS mode. A container shares the node's kernel and cannot enable it.
         Verified on the node instead. -->
    <xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_configure_crypto_policy"
                      selected="false"/>

    <!-- =====================================================================
         2. SELECT - turn ON a rule the base profile left off
         =====================================================================
         Less common, but this is how a local policy that is STRICTER than the
         STIG gets expressed. Same syntax, selected="true".
    -->
    <!--
    <xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_package_rsyslog_installed"
                      selected="true"/>
    -->

    <!-- =====================================================================
         3. REFINE-VALUE - change a parameter without changing the rule
         =====================================================================
         Rules that check a threshold read it from an XCCDF <Value>. To require
         a 20-character minimum password length instead of the STIG's 15, you do
         NOT edit the rule - you point its value at a different selector.

         The `selector` must be one the Value actually defines. Find the
         available selectors with:
             oscap info --profile <profile> /usr/share/xml/scap/ssg/content/ssg-rhel9-ds.xml
         or by grepping the datastream for the value id. An invalid selector
         makes oscap exit 1.

         Raising a threshold above the STIG minimum is always safe to do.
         LOWERING one is a deviation and needs the same approval as a waiver.
    -->
    <!--
    <xccdf-1.2:refine-value idref="xccdf_org.ssgproject.content_value_var_password_pam_minlen"
                            selector="20"/>
    -->

    <!-- =====================================================================
         4. SET-VALUE - set a value directly
         =====================================================================
         Where refine-value picks a predefined selector, set-value supplies a
         literal. Use it when the value you need has no selector defined.
    -->
    <!--
    <xccdf-1.2:set-value idref="xccdf_org.ssgproject.content_value_var_accounts_maximum_age_login_defs">60</xccdf-1.2:set-value>
    -->

  </xccdf-1.2:Profile>
</xccdf-1.2:Tailoring>
